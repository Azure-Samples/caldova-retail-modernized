<article class="card product-card h-100">
    <a href="@DetailsUrl" class="product-media" tabindex="-1" aria-hidden="true">
        <img src="Images/@Product.ImageUrl" alt="" loading="lazy" />
    </a>
    <div class="card-body d-flex flex-column gap-2">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <h2 class="product-name mb-0"><a href="@DetailsUrl">@Product.Name</a></h2>
            <span class="price text-nowrap">USD @Product.Price.ToString("N2")</span>
        </div>
        <p class="product-description mb-0 flex-grow-1">@Product.Description</p>
        <span class="product-id">Item #@Product.Id</span>
        <FormMappingScope Name="@($"product-{Product.Id}")">
            <AddToCartForm ProductId="Product.Id" ProductName="@Product.Name" ReturnUrl="@ReturnUrl" Compact="true" />
        </FormMappingScope>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; }
    [Parameter] public string ReturnUrl { get; set; }

    private string DetailsUrl => $"Home/Product/{Product.Id}";
}
